<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
              https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="hotelPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
<!--        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>-->
        <class>com.academy.hotel_jpa.entity.user.User</class>
        <class>com.academy.hotel_jpa.entity.user.privilege.Privilege</class>
        <class>com.academy.hotel_jpa.entity.country.Country</class>
        <class>com.academy.hotel_jpa.entity.country.town.Town</class>
        <class>com.academy.hotel_jpa.entity.country.town.address.Address</class>
        <class>com.academy.hotel_jpa.entity.room.Room</class>
        <class>com.academy.hotel_jpa.entity.reservation.Reservation</class>
        <class>com.academy.hotel_jpa.entity.reservation.guest.Guest</class>
        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/hotel"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="root"/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
        </properties>
    </persistence-unit>
</persistence>